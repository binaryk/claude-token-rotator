#!/usr/bin/env python3
"""ctr entry point.

Resolves its own location through symlinks (it is installed as
~/.local/bin/ctr -> <repo>/bin/ctr), puts the repo's src/ on sys.path, and hands
over to ctr.cli.main().
"""

import os
import sys

_HERE = os.path.realpath(os.path.abspath(__file__))
_SRC = os.path.join(os.path.dirname(os.path.dirname(_HERE)), "src")
if os.path.isdir(_SRC) and _SRC not in sys.path:
    sys.path.insert(0, _SRC)

try:
    from ctr.cli import main
except ImportError as exc:  # a broken checkout should say so, not traceback
    sys.stderr.write("ctr: cannot load the ctr package from %s (%s)\n" % (_SRC, exc))
    sys.exit(1)

if __name__ == "__main__":
    sys.exit(main())
